# Your own notes and drops — keep them out of version control.
inbox/*
!inbox/.gitkeep
out/
*.private.*
.env
.env.*

# Runtime state — your own data. Only the shipped seeds and READMEs are tracked.
.navig/memory/*
!.navig/memory/README.md
!.navig/memory/.gitkeep
!.navig/memory/*.example.*
.navig/state/*
!.navig/state/.gitkeep
.navig/inbox/*
!.navig/inbox/.gitkeep
!.navig/inbox/README.md
!.navig/inbox/*.example.*
!.navig/inbox/docs/
!.navig/inbox/shortcuts/
.navig/logs/*
!.navig/logs/.gitkeep
