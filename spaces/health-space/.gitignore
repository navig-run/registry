# Health data is sensitive — keep your own records out of version control.
# Drop zone and exports (symptoms, screenshots, lab results)
inbox/*
!inbox/.gitkeep
out/
# Private reference notes
docs/private/
*.private.*
# Scans and exports — store these encrypted with `navig cabinet add <file> --category medical`
*.pdf
*.jpg
*.jpeg
*.png
*.heic
*.csv
.env
.env.*

# Runtime state — your own data. Only the shipped seeds and READMEs are tracked.
.navig/memory/*
!.navig/memory/README.md
!.navig/memory/.gitkeep
!.navig/memory/*.example.*
.navig/state/*
!.navig/state/.gitkeep
.navig/inbox/*
!.navig/inbox/.gitkeep
!.navig/inbox/README.md
!.navig/inbox/*.example.*
!.navig/inbox/docs/
!.navig/inbox/shortcuts/
.navig/logs/*
!.navig/logs/.gitkeep
