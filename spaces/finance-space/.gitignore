# Financial data - never commit real data
transactions/**/*.csv
accounts/*.json
budgets/**/*.json
goals/*.json
documents/tax/
documents/statements/
reports/

# Keep templates
!accounts/_template/
!budgets/_template/
!goals/_template/
!accounts/_template/*.json
!budgets/_template/*.json
!goals/_template/*.json

# NAVIG runtime
.navig/cache/
.navig/logs/
*.log

# Runtime state — your own data. Only the shipped seeds and READMEs are tracked.
.navig/memory/*
!.navig/memory/README.md
!.navig/memory/.gitkeep
!.navig/memory/*.example.*
.navig/state/*
!.navig/state/.gitkeep
.navig/inbox/*
!.navig/inbox/.gitkeep
!.navig/inbox/README.md
!.navig/inbox/*.example.*
!.navig/inbox/docs/
!.navig/inbox/shortcuts/
.navig/logs/*
!.navig/logs/.gitkeep
